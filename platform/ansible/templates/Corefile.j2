{{ samba_ad_dns_zone }}:53 {
    errors
    bind {{ rke2_api_endpoint }}
    forward . {{ samba_ad_dc_ip }}
    cache 30
    reload
}

.:53 {
    errors
    bind {{ rke2_api_endpoint }}
    health
    ready
    log

    hosts {
        {{ rke2_api_endpoint }} {{ rke2_api_hostname }} k8s.{{ coredns_environment }}.{{ coredns_domain }} ad.{{ coredns_environment }}.{{ coredns_domain }}
        {{ vault_ip }} {{ vault_hostname }}
{% for host in groups['rke2_servers'] | default([]) %}
        {{ hostvars[host].ansible_host }} {{ host }}.{{ coredns_domain }} {{ host | regex_replace('^' ~ coredns_environment ~ '-', '') }}.{{ coredns_environment }}.{{ coredns_domain }}
{% endfor %}
{% for host in groups['rke2_agents'] | default([]) %}
        {{ hostvars[host].ansible_host }} {{ host }}.{{ coredns_domain }} {{ host | regex_replace('^' ~ coredns_environment ~ '-', '') }}.{{ coredns_environment }}.{{ coredns_domain }}
{% endfor %}
        fallthrough
    }

    forward . {{ coredns_upstream_servers | join(' ') }}
    cache 30
    reload
}