[req]
default_bits = 4096
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
CN = {{ vault_hostname }}

[v3_req]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = {{ vault_hostname }}
DNS.2 = {{ inventory_hostname }}
DNS.3 = {{ inventory_hostname | regex_replace('^' ~ coredns_environment ~ '-', '') }}
IP.1 = {{ vault_ip }}