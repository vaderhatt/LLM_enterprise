[libdefaults]
    default_realm = {{ samba_realm }}
    dns_lookup_realm = false
    dns_lookup_kdc = true

[realms]
    {{ samba_realm }} = {
        kdc = {{ samba_dc_short_hostname }}.{{ samba_dns_zone }}
        admin_server = {{ samba_dc_short_hostname }}.{{ samba_dns_zone }}
    }

[domain_realm]
    .{{ samba_dns_zone }} = {{ samba_realm }}
    {{ samba_dns_zone }} = {{ samba_realm }}